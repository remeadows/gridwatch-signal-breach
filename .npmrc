# @gridwatch/account-kit is a git-tag dependency; npm 12 refuses git deps unless allowed.
# root restricts git deps to those declared by the root package.json (CI: npm ci under root passes).
# To bump the kit tag, re-resolve once with: npm install --allow-git=all   (npm 12.0.2 on node 24 rejects the fresh re-resolution under root with EALLOWGIT — reproduced 2026-09-12; re-test after the next npm upgrade.)
allow-git=root
