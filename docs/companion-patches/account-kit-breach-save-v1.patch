+                seed: { type: "string", maxLength: 200, pattern: /[\s\S]/ },
+                // t * 1024 + opcode * 64 + y * 8 + x; reserved opcodes rejected by game.
+                commands: { type: "array", maxLength: 5000, items: { type: "integer", min: 0, max: 12287551 } },
+            },
+        },
