{
  "name": "gridwatch-signal-breach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --mode lan-preview --host 0.0.0.0 --port 4392 --strictPort",
    "dev:local": "vite --host 127.0.0.1 --port 4391 --strictPort",
    "build": "tsc && vite build",
    "preview": "vite preview",
