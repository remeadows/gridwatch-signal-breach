    "verify:expansion-progress-r4": "node scripts/run-typescript.mjs scripts/verify-expansion-progress-r4.ts",
    "verify:expansion-checkpoints": "node scripts/run-typescript.mjs scripts/verify-expansion-checkpoints.ts",
    "verify:expansion-save-sync": "node scripts/run-typescript.mjs scripts/verify-expansion-save-sync.ts",
    "verify:expansion-save-api": "node scripts/run-typescript.mjs scripts/verify-expansion-save-api.ts",
    "verify:expansion-r4-evidence": "node scripts/run-typescript.mjs scripts/verify-expansion-r4-evidence.ts",
    "verify:expansion-r4-drafts": "node scripts/run-typescript.mjs scripts/verify-r4-drafts.ts",
